# TrainForge Docker Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# GitHub App Configuration
# ============================================
# Create a GitHub App at: https://github.com/settings/apps/new
# See docs/GITHUB_APP_ARCHITECTURE.md for detailed setup instructions

# Your GitHub App ID (found on the app's settings page after creation)
GITHUB_APP_ID=123456

# OAuth Client ID (found in the app's settings under "Client ID")
GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxx

# OAuth Client Secret (generate in the app's settings)
GITHUB_APP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Private Key (generate in the app's settings, paste entire PEM content)
# For Docker, use \n for newlines in the key
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"

# Webhook Secret (set when configuring webhook, or leave as placeholder for local dev)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# Security
# ============================================
# Secret key for JWT tokens
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32

# ============================================
# Note: Database URL is configured in docker-compose.yml
# No need to set it here for Docker deployment
# ============================================
